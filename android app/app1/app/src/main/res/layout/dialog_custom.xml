<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginStart="20dp"
    android:layout_marginTop="20dp"
    android:layout_marginEnd="20dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить вещь"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Выберите источник фото для распознавания"
            android:textColor="@color/gray"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/btnTakePhoto"
            style="@style/AddItemOptionRow"
            android:layout_marginTop="18dp">

            <ImageView
                style="@style/AddItemOptionIcon"
                android:src="@drawable/ic_by_photo" />

            <LinearLayout style="@style/AddItemOptionTextGroup">

                <TextView
                    style="@style/AddItemOptionTitle"
                    android:text="Сделать фото" />

                <TextView
                    style="@style/AddItemOptionSubtitle"
                    android:text="Открыть камеру и сфотографировать вещь" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPickPhotoByGallery"
            style="@style/AddItemOptionRow">

            <ImageView
                style="@style/AddItemOptionIcon"
                android:src="@drawable/ic_by_gallery" />

            <LinearLayout style="@style/AddItemOptionTextGroup">

                <TextView
                    style="@style/AddItemOptionTitle"
                    android:text="Загрузить из галереи" />

                <TextView
                    style="@style/AddItemOptionSubtitle"
                    android:text="Выбрать готовое фото с устройства" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPickPhotoByLink"
            style="@style/AddItemOptionRow">

            <ImageView
                style="@style/AddItemOptionIcon"
                android:src="@drawable/ic_by_link" />

            <LinearLayout style="@style/AddItemOptionTextGroup">

                <TextView
                    style="@style/AddItemOptionTitle"
                    android:text="Загрузить по ссылке" />

                <TextView
                    style="@style/AddItemOptionSubtitle"
                    android:text="Вставить ссылку на товар или артикул Wildberries" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
